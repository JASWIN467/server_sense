# DO NOT COMMIT REAL SECRETS
# This is a template. Copy this to secret.yaml and fill in your actual values.
# The real secret.yaml must be gitignored!
apiVersion: v1
kind: Secret
metadata:
  name: serversense-secrets
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://<user>:<password>@cluster.mongodb.net/serversense"
  JWT_SECRET: "your_jwt_secret_here"
  GEMINI_API_KEY: "your_gemini_api_key_here"
