# MongoDB Connection String (e.g. Free MongoDB Atlas M0 cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.prmvy7o.mongodb.net/serversense?retryWrites=true&w=majority

# Port for the Express server (Render/Cloud providers will inject PORT automatically)
PORT=5000

# Google Gemini API key for automated AI diagnostics
GEMINI_API_KEY=your_gemini_api_key

# Telegram Bot Token for notification alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Secret key for JWT auth token generation
JWT_SECRET=your_super_secret_jwt_key
